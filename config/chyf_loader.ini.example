; Configuration for chyf_loader/scripts/load.py.
; Copy this file to chyf_loader.ini and edit as needed.
;
; Do NOT put database connection info (host/port/user/password) here.
; Those come from GitHub Actions secrets / environment variables only:
;   FISHPASS_HOST, FISHPASS_PORT, FISHPASS_DBNAME, FISHPASS_USER, FISHPASS_PASSWORD

[workunits]
; Comma-separated list of chyf2.aoi.short_name values to load.
; All existing data for all workunit(s) will be deleted and reloaded.
;
short_names = 08MF001,08MF002

[target]
; Schema-qualified FishPass-side tables that get truncated and reloaded.
flowpath_table = chyf_raw.flowpath
aoi_table = chyf_raw.aoi
shoreline_table = chyf_raw.shoreline

[source]
; Schema-qualified CHyF2 tables, as seen through the FDW-imported local schema.
; fdw_server is recorded for traceability only -- it is not substituted into any SQL.
flowpath_table = chyf2_fdw.eflowpath
flowpath_properties_table = chyf2_fdw.eflowpath_properties
aoi_table = chyf2_fdw.aoi
shoreline_table = chyf2_fdw.shoreline

[behavior]
; If true, print the psql commands that would run without executing them.
dry_run = false
; One of: debug, info, warning, error
verbosity = info
